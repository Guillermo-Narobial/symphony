DMS_URL=https://example.internal/BNC/dms
DMS_ACCESS_TOKEN=replace-with-dms-token
DMS_CLIENT_ID=replace-with-client-id
DMS_METODO=GET.PROYECTOS
DMS_ENTIDAD=CATALOGO
DMS_METHOD_TYPE=GET
DMS_SERVER_CODE=1297
DMS_HEADERS={"headers":{"idp":"AGENT-NAROBIAL","profile":"App_qservers"}}
DMS_CUSTOM_INTERFACE={"interfaces":["id","analystDeveloperId","assignedDate","brandId","closingDate","countryId","creationDate","creationHour","creationUser","customerId","customerRequirements","groupId","isClosed","isNarobial","isOpened","isProject","isQ700","isQuiter","isSuggestion","projectManagerId","requirements","statusId","title","typeId","uploadDate","userCode"]}
DMS_SEARCH_VALUE=usuario
DMS_IS_OPENED=true
GITHUB_REPO=owner/repo
REJECT_ASSIGNEE=github-user
CRON_SCHEDULE=*/5 * * * *
REPOS_DIR=./repos
FRONTEND_REPO_DIR=./repos/Narobial-Frontend
AGENT_WORKSPACES_DIR=./repos
MAX_CONCURRENT_AGENTS=3
MAX_AGENT_RETRIES=3
AGENT_STUCK_MINUTES=45
AGENT_HEALTH_ALERT_COOLDOWN_MINUTES=60
AGENT_HEALTH_DASHBOARD_HTML=./docs/agent-health.html
AGENT_HEALTH_DASHBOARD_JSON=./docs/agent-health.json
SOLVER_COMMAND=kiro
PROCESSING_LABEL=agente-trabajando
DEPLOY_HOST=deploy-host.example.internal
DEPLOY_SSH_KEY=~/.ssh/id_ed25519
DEPLOY_BUILD_CMD=build-hotfix

# Telegram Bot (opcional - si no se configura, el bot no arranca)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Status Server
STATUS_SERVER_PORT=4040
STATUS_SERVER_HOST=127.0.0.1
# Leave empty to disable POST /api/issues; set a secret to enable it.
STATUS_SERVER_TOKEN=

# LLM (gpt-4o-mini para chat natural del bot — opcional)
OPENAI_API_KEY=